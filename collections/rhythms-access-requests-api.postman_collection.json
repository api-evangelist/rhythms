        {
          "id": "a8c4ed7c-ba4b-4cc8-b68e-c25611933604",
          "name": "Re-notify the owner/managers about the caller's pending request",
          "request": {
            "name": "Re-notify the owner/managers about the caller's pending request",
            "description": {
              "content": "Re-sends the access-request notification for the current user's own pending request (in-app re-surface + email), throttled to once per hour. Lets a requestor nudge an ignored request instead of being stuck. Self-scoped and tenant-scoped like the other actions. Returns { status: \"resent\" } when re-notified, { status: \"throttled\" } within the window, or { status: \"no_pending_request\" } when the caller has none.",
              "type": "text/plain"
            },
