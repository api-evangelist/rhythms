        {
          "id": "8808c99b-b844-409e-8450-2f6beff28313",
          "name": "Get the caller's own pending access request",
          "request": {
            "name": "Get the caller's own pending access request",
            "description": {
              "content": "Returns the current user's own pending access request for a shareable (or none). Self-scoped: it only ever reports the caller's request, so it leaks nothing about the resource or other users' requests, and (like create) requires no existing access. The UI uses this to show a persistent \"Access requested\" state across page refreshes.",
              "type": "text/plain"
            },
